<%= turbo_frame_tag "customer_section" do %>
  <h3 class="subsection-title mb-3">Klient</h3>
  <%= form_with model: @order, url: order_path(@order), method: :patch do |f| %>
    <div class="space-y-3" data-controller="order-customer-search">
      <div class="flex justify-between items-center">
        <span class="label-text">Nazwa</span>
        <div class="relative w-44">
          <input type="text"
                 class="input input-bordered input-sm w-full"
                 placeholder="Szukaj klienta..."
                 autocomplete="off"
                 value="<%= @order.customer&.name %>"
                 data-order-customer-search-target="searchInput"
                 data-action="input->order-customer-search#filter focus->order-customer-search#openDropdown">
          <%= f.hidden_field :customer_id, data: { order_customer_search_target: "customerIdInput" } %>
          <div class="hidden absolute z-10 top-full left-0 right-0 mt-1 border border-base-300 rounded-lg bg-base-100 shadow-lg max-h-48 overflow-y-auto"
               data-order-customer-search-target="dropdown"></div>
        </div>
      </div>
    </div>
    <div class="flex justify-end gap-2 mt-4">
      <%= link_to "Anuluj", order_path(@order), class: "btn btn-ghost btn-sm" %>
      <%= f.submit "Przypisz", class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
<% end %>
