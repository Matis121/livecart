<%= turbo_frame_tag "transmissions_list_modal" do %>
  <dialog id="transmissions_list_modal" class="modal modal-open">
    <div class="modal-box max-w-md max-h-[90vh]">
      <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2"
              onclick="document.getElementById('transmissions_list_modal').innerHTML = ''">
        ✕
      </button>
      <h3 class="font-bold text-lg mb-4">
        <%= lucide_icon('radio', class: 'w-5 h-5 inline-block') %>
        Transmisje - <%= @order.order_number %>
      </h3>
      <% if @transmissions.any? %>
        <div class="flex flex-col divide-y divide-base-200">
          <% @transmissions.each do |transmission| %>
            <%= link_to transmission_path(transmission), class: "flex items-center justify-between py-3 px-2 hover:bg-base-200/50 rounded-lg transition-colors", data: { turbo_frame: "_top" } do %>
              <div class="flex flex-col gap-0.5 min-w-0">
                <span class="font-medium text-sm truncate"><%= transmission.name %></span>
                <span class="text-xs text-base-content/50"><%= l(transmission.created_at, format: :short) %></span>
              </div>
              <span class="badge badge-sm <%= transmission.active? ? 'badge-info' : transmission.processing? ? 'badge-warning' : transmission.completed? ? 'badge-success' : 'badge-error' %> shrink-0">
                <%= transmission.active? ? 'Aktywna' : (transmission.processing? ? 'Przetwarzanie' : (transmission.completed? ? 'Zakończona' : 'Anulowana')) %>
              </span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="alert alert-info">
          <%= lucide_icon('info', class: 'w-4 h-4') %>
          <span>Brak transmisji dla tego zamówienia</span>
        </div>
      <% end %>
    </div>
    <div class="modal-backdrop"
         onclick="document.getElementById('transmissions_list_modal').innerHTML = ''">
    </div>
  </dialog>
<% end %>
