<!-- Shop header bar -->
<div class="flex items-center gap-3 mb-8 pb-5 border-b border-base-300/60">
  <% if account_logo.present? %>
    <div class="w-10 h-10 rounded-xl overflow-hidden bg-base-100 border border-base-300 flex items-center justify-center shrink-0">
      <%= image_tag account_logo, alt: "logo", class: "w-full h-full object-contain p-1.5" %>
    </div>
  <% end %>
  <div class="min-w-0">
    <p class="tiny-text mb-0.5">Zakup w</p>
    <h4 class="subsection-title tracking-tight truncate"><%= account_name %></h4>
  </div>
</div>

<!-- Status zamówienia -->
<div class="flex items-center gap-3 mb-6">
  <div class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-success/10 shrink-0">
    <%= lucide_icon "check", class: "w-5 h-5 text-success stroke-[2.5]" %>
  </div>
  <div>
    <h1 class="subsection-title tracking-tight">
      <%= order.open_package_status? ? "Paczka zamknięta" : "Zamówienie złożone" %>
    </h1>
    <p class="caption-text text-base-content/50">Nr zamówienia: <span class="font-medium text-base-content/70"><%= order.order_number %></span></p>
  </div>
</div>

<!-- Main grid -->
<div class="flex flex-col xl:flex-row gap-6 items-start">
  <!-- Left column: szczegóły -->
  <div class="flex-1 min-w-0 space-y-4">

    <!-- Adres dostawy -->
    <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
      <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
        <h2 class="subsection-title tracking-tight">Adres dostawy</h2>
      </div>
      <div class="p-6">
        <div class="bg-base-200/40 rounded-xl p-4 space-y-0.5">
          <p class="body-text font-semibold"><%= order.shipping_address.first_name %> <%= order.shipping_address.last_name %></p>
          <p class="body-secondary"><%= order.shipping_address.address_line1 %></p>
          <% if order.shipping_address.address_line2.present? %>
            <p class="body-secondary"><%= order.shipping_address.address_line2 %></p>
          <% end %>
          <p class="body-secondary"><%= order.shipping_address.postal_code %> <%= order.shipping_address.city %></p>
        </div>
      </div>
    </div>

    <!-- Dane do faktury -->
    <% if order.billing_address.needs_invoice? %>
      <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
        <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
          <h2 class="subsection-title tracking-tight">Dane do faktury</h2>
        </div>
        <div class="p-6">
          <div class="bg-base-200/40 rounded-xl p-4 space-y-0.5">
            <% if order.billing_address.company_name.present? %>
              <p class="body-text font-semibold"><%= order.billing_address.company_name %></p>
            <% end %>
            <% if order.billing_address.nip.present? %>
              <p class="body-secondary">NIP: <%= order.billing_address.nip %></p>
            <% end %>
            <p class="body-secondary"><%= order.billing_address.first_name %> <%= order.billing_address.last_name %></p>
            <p class="body-secondary"><%= order.billing_address.address_line1 %></p>
            <p class="body-secondary"><%= order.billing_address.postal_code %> <%= order.billing_address.city %></p>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Dostawa i płatność -->
    <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
      <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
        <h2 class="subsection-title tracking-tight">Dostawa i płatność</h2>
      </div>
      <div class="p-6 space-y-3">
        <% if order.shipping_method.present? %>
          <div class="flex items-center gap-3">
            <%= lucide_icon "truck", class: "w-4 h-4 text-base-content/40 shrink-0" %>
            <div>
              <p class="body-text font-medium"><%= order.shipping_method %></p>
              <% if order.pickup_point.present? %>
                <p class="caption-text text-base-content/50"><%= order.pickup_point.name %>, <%= order.pickup_point.address_line1 %>, <%= order.pickup_point.postal_code %> <%= order.pickup_point.city %></p>
              <% end %>
            </div>
            <span class="ml-auto body-secondary shrink-0">
              <%= order.shipping_cost > 0 ? number_to_currency(order.shipping_cost) : "Darmowa" %>
            </span>
          </div>
        <% end %>
        <% if order.payment_method.present? %>
          <div class="flex items-center gap-3">
            <%= lucide_icon "credit-card", class: "w-4 h-4 text-base-content/40 shrink-0" %>
            <p class="body-text font-medium"><%= order.payment_method %></p>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <!-- Right column: podsumowanie produktów -->
  <div class="w-full xl:w-105 shrink-0 order-first xl:order-last">
    <div class="xl:sticky xl:top-6">
      <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
        <div class="px-6 py-4 bg-base-200/40 border-b border-base-300/40">
          <h2 class="subsection-title tracking-tight">Twoje zamówienie</h2>
        </div>
        <% if order.order_items.any? %>
          <div class="p-6 space-y-4">
            <% order.order_items.includes(:product).each do |item| %>
              <div class="flex gap-3">
                <div class="w-16 h-16 rounded-xl bg-base-200 overflow-hidden border border-base-300/60 shrink-0">
                  <% if item.product&.images&.attached? %>
                    <%= image_tag item.product.images.first.variant(:thumb), class: "object-cover w-full h-full" %>
                  <% else %>
                    <div class="w-full h-full flex items-center justify-center">
                      <%= lucide_icon "image", class: "w-6 h-6 text-base-content/20" %>
                    </div>
                  <% end %>
                </div>
                <div class="flex-1 min-w-0 flex flex-col justify-center gap-0.5">
                  <p class="body-text font-medium leading-snug line-clamp-2"><%= item.product&.name || "Produkt" %></p>
                  <p class="caption-text text-base-content/50">
                    <%= item.quantity %> szt. &times; <%= number_to_currency(item.unit_price) %>
                  </p>
                  <p class="body-text font-semibold text-base-content/80"><%= number_to_currency(item.total_price) %></p>
                </div>
              </div>
            <% end %>
          </div>
          <div class="border-t border-base-200 mx-6"></div>
          <div class="px-6 py-4 space-y-2">
            <div class="flex justify-between">
              <span class="body-secondary">Produkty</span>
              <span class="body-text font-medium"><%= number_to_currency(order.order_items.sum(&:total_price)) %></span>
            </div>
            <div class="flex justify-between">
              <span class="body-secondary">Dostawa</span>
              <% if order.shipping_cost > 0 %>
                <span class="body-text font-medium"><%= number_to_currency(order.shipping_cost) %></span>
              <% else %>
                <span class="body-text font-medium text-success">Darmowa</span>
              <% end %>
            </div>
            <% if order.discount_amount.to_f > 0 %>
              <div class="flex justify-between">
                <span class="body-secondary text-success">Rabat (<%= order.discount_name %>)</span>
                <span class="body-text font-medium text-success">−<%= number_to_currency(order.discount_amount) %></span>
              </div>
            <% end %>
          </div>
          <div class="border-t border-base-200 mx-6"></div>
          <div class="px-6 py-5 flex justify-between items-center">
            <span class="subsection-title">Do zapłaty</span>
            <span class="text-2xl font-bold tracking-tight"><%= number_to_currency(order.total_amount) %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
