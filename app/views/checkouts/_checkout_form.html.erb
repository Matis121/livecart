<%
  show_phase2 = (order.customer.present? && order.customer.has_saved_shipping_address?) ||
                local_assigns[:from_phase2].present?
  initial_phase = show_phase2 ? 2 : 1
%>

<!-- Shop header bar -->
<div class="flex items-center gap-3 mb-8 pb-5 border-b border-base-300/60">
  <% if account_logo.present? %>
    <div class="w-10 h-10 rounded-xl overflow-hidden bg-base-100 border border-base-300 flex items-center justify-center shrink-0">
      <%= image_tag account_logo, alt: "logo", class: "w-full h-full object-contain p-1.5" %>
    </div>
  <% end %>
  <div class="min-w-0">
    <p class="tiny-text mb-0.5">Zakup w</p>
    <h4 class="subsection-title tracking-tight truncate"><%= account_name %></h4>
  </div>
  <div class="ml-auto flex items-center gap-1.5 shrink-0">
    <%= lucide_icon "lock", class: "w-3 h-3" %>
    <span class="caption-text hidden sm:inline">Bezpieczna płatność</span>
  </div>
</div>

<!-- Main grid -->
<div class="flex flex-col xl:flex-row gap-6 items-start">
  <!-- Left column: Form -->
  <div class="flex-1 min-w-0">
    <% items_subtotal = order.order_items.sum(:total_price) %>
    <%= form_with model: order, url: checkout_path(order.account.slug, checkout.token), method: :patch, local: true,
        data: {
          controller: "checkout-form checkout-phases",
          checkout_form_items_subtotal_value: items_subtotal.to_f,
          checkout_form_discount_amount_value: (order.discount_amount || 0).to_f,
          checkout_form_inpost_widget_token_value: @inpost_widget_token,
          checkout_form_orlen_widget_token_value: @orlen_widget_token,
          checkout_phases_initial_phase_value: initial_phase
        } do |f| %>

      <% base_errors = order.errors[:base] %>
      <% if base_errors.any? %>
        <div class="alert alert-error rounded-xl mb-4">
          <ul class="list-disc list-inside text-sm space-y-0.5">
            <% base_errors.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <!-- ===================== FAZA 1: Zbieranie danych ===================== -->
      <div data-checkout-phases-target="phase1"
           class="<%= 'hidden' if show_phase2 %> space-y-4">

        <!-- 1. Dane kontaktowe -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
          <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
            <h2 class="subsection-title tracking-tight">Dane kontaktowe</h2>
          </div>
          <div class="p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div class="form-control"
                   <% if order.customer.nil? %>
                     data-controller="email-check"
                     data-email-check-url-value="<%= check_email_checkout_path(order.account.slug, checkout.token) %>"
                   <% end %>>
                <%= f.label :email, "Email *", class: "label label-text font-medium" %>
                <%= f.email_field :email,
                  class: "input input-bordered w-full rounded-xl #{"input-error" if order.errors[:email].any?}",
                  required: true,
                  placeholder: "twoj@email.pl",
                  data: order.customer.nil? ? { email_check_target: "input", action: "blur->email-check#check" } : {} %>
                <p data-email-check-target="error"
                   class="label label-text-alt text-error mt-1 <%= "hidden" unless order.errors[:email].any? %>">
                  <%= order.errors[:email].first %>
                </p>
              </div>
              <div class="form-control">
                <%= f.label :phone, "Telefon *", class: "label label-text font-medium" %>
                <%
                  checkout_phone = order.phone.to_s
                  checkout_prefixes = [
                    "+48", "+49", "+43", "+32", "+45", "+33", "+30", "+31", "+353",
                    "+39", "+1", "+47", "+351", "+40", "+421", "+386", "+34", "+46",
                    "+41", "+380", "+44", "+420", "+36"
                  ]
                  checkout_prefix = checkout_prefixes.sort_by { |p| -p.length }.find { |p| checkout_phone.start_with?(p) } || "+48"
                  checkout_number = checkout_phone.delete_prefix(checkout_prefix)
                %>
                <div class="flex gap-2">
                  <select name="order[phone_prefix]" class="select select-bordered w-28 shrink-0 rounded-xl">
                    <% checkout_prefixes.each do |prefix| %>
                      <option value="<%= prefix %>" <%= "selected" if checkout_prefix == prefix %>><%= prefix %></option>
                    <% end %>
                  </select>
                  <input type="tel"
                         name="order[phone_number]"
                         class="input input-bordered flex-1 rounded-xl"
                         placeholder="123456789"
                         value="<%= checkout_number %>"
                         required
                         maxlength="9"
                         oninput="this.value = this.value.replace(/\D/g, '').slice(0, 9)">
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- 2. Adres dostawy -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
          <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
            <h2 class="subsection-title tracking-tight">Adres dostawy</h2>
          </div>
          <div class="p-6">
            <%= f.fields_for :shipping_address_attributes, order.shipping_address do |sa| %>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="form-control">
                  <%= sa.label :first_name, "Imię *", class: "label label-text font-medium" %>
                  <%= sa.text_field :first_name,
                    class: "input input-bordered w-full rounded-xl",
                    required: true,
                    data: { checkout_phases_target: "shippingFirstName" } %>
                </div>
                <div class="form-control">
                  <%= sa.label :last_name, "Nazwisko *", class: "label label-text font-medium" %>
                  <%= sa.text_field :last_name,
                    class: "input input-bordered w-full rounded-xl",
                    required: true,
                    data: { checkout_phases_target: "shippingLastName" } %>
                </div>
                <div class="form-control md:col-span-2">
                  <%= sa.label :address_line1, "Ulica i numer *", class: "label label-text font-medium" %>
                  <%= sa.text_field :address_line1,
                    class: "input input-bordered w-full rounded-xl",
                    required: true,
                    placeholder: "np. ul. Główna 123",
                    data: { checkout_phases_target: "shippingAddress1" } %>
                </div>
                <div class="form-control md:col-span-2">
                  <%= sa.label :address_line2, "Dodatkowe informacje", class: "label label-text font-medium" %>
                  <%= sa.text_field :address_line2,
                    class: "input input-bordered w-full rounded-xl",
                    placeholder: "np. mieszkanie 4, kod domofonu",
                    data: { checkout_phases_target: "shippingAddress2" } %>
                </div>
                <div class="form-control">
                  <%= sa.label :postal_code, "Kod pocztowy *", class: "label label-text font-medium" %>
                  <%= sa.text_field :postal_code,
                    class: "input input-bordered w-full rounded-xl",
                    required: true,
                    placeholder: "00-000",
                    data: { checkout_phases_target: "shippingPostalCode" } %>
                </div>
                <div class="form-control">
                  <%= sa.label :city, "Miasto *", class: "label label-text font-medium" %>
                  <%= sa.text_field :city,
                    class: "input input-bordered w-full rounded-xl",
                    required: true,
                    data: { checkout_phases_target: "shippingCity" } %>
                </div>
                <div class="form-control md:col-span-2">
                  <%= sa.label :country, "Kraj *", class: "label label-text font-medium" %>
                  <%= sa.select :country,
                    options_for_select(ShippingAddress::COUNTRIES, order.shipping_address.country.presence || "PL"),
                    { required: true },
                    class: "select select-bordered w-full rounded-xl" %>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- 3. Dane do faktury -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
          <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
            <h2 class="subsection-title tracking-tight">Dane do faktury</h2>
          </div>
          <div class="p-6">
            <%= f.fields_for :billing_address_attributes, order.billing_address do |ba| %>
              <div class="form-control mb-4">
                <label class="label cursor-pointer justify-start gap-3 p-0">
                  <%= ba.check_box :needs_invoice,
                    class: "checkbox checkbox-primary",
                    data: {
                      checkout_phases_target: "needsInvoice",
                      action: "change->checkout-phases#toggleInvoice"
                    } %>
                  <span class="label-text font-medium">Chcę otrzymać fakturę VAT</span>
                </label>
              </div>
              <div data-checkout-phases-target="invoiceFields"
                   class="<%= 'hidden' unless order.billing_address.needs_invoice %> space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  <div class="form-control md:col-span-2">
                    <%= ba.label :company_name, "Nazwa firmy", class: "label label-text font-medium" %>
                    <%= ba.text_field :company_name,
                      class: "input input-bordered w-full rounded-xl",
                      data: { checkout_phases_target: "billingCompany" } %>
                  </div>
                  <div class="form-control">
                    <%= ba.label :nip, "NIP", class: "label label-text font-medium" %>
                    <%= ba.text_field :nip,
                      class: "input input-bordered w-full rounded-xl",
                      placeholder: "0000000000",
                      data: { checkout_phases_target: "billingNip" } %>
                  </div>
                  <div class="form-control">
                    <%= ba.label :first_name, "Imię", class: "label label-text font-medium" %>
                    <%= ba.text_field :first_name,
                      class: "input input-bordered w-full rounded-xl",
                      data: { checkout_phases_target: "billingFirstName" } %>
                  </div>
                  <div class="form-control">
                    <%= ba.label :last_name, "Nazwisko", class: "label label-text font-medium" %>
                    <%= ba.text_field :last_name,
                      class: "input input-bordered w-full rounded-xl",
                      data: { checkout_phases_target: "billingLastName" } %>
                  </div>
                  <div class="form-control md:col-span-2">
                    <%= ba.label :address_line1, "Ulica i numer", class: "label label-text font-medium" %>
                    <%= ba.text_field :address_line1,
                      class: "input input-bordered w-full rounded-xl",
                      data: { checkout_phases_target: "billingAddress1" } %>
                  </div>
                  <div class="form-control">
                    <%= ba.label :postal_code, "Kod pocztowy", class: "label label-text font-medium" %>
                    <%= ba.text_field :postal_code,
                      class: "input input-bordered w-full rounded-xl",
                      placeholder: "00-000",
                      data: { checkout_phases_target: "billingPostalCode" } %>
                  </div>
                  <div class="form-control">
                    <%= ba.label :city, "Miasto", class: "label label-text font-medium" %>
                    <%= ba.text_field :city,
                      class: "input input-bordered w-full rounded-xl",
                      data: { checkout_phases_target: "billingCity" } %>
                  </div>
                  <div class="form-control md:col-span-2">
                    <%= ba.label :country, "Kraj", class: "label label-text font-medium" %>
                    <%= ba.select :country,
                      options_for_select(BillingAddress::COUNTRIES, order.billing_address.country.presence || "PL"),
                      {},
                      class: "select select-bordered w-full rounded-xl" %>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <!-- Kontynuuj -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm p-6">
          <button type="button"
                  class="btn btn-primary btn-lg w-full rounded-xl font-semibold"
                  data-action="click->checkout-phases#continue">
            Kontynuuj
          </button>
        </div>

      </div>
      <!-- ===================== END FAZA 1 ===================== -->

      <!-- ===================== FAZA 2: Podsumowanie + wysyłka/płatność ===================== -->
      <div data-checkout-phases-target="phase2"
           class="<%= 'hidden' unless show_phase2 %> space-y-4">

        <!-- Box: Adres dostawy -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
          <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
            <h2 class="subsection-title tracking-tight">Adres dostawy</h2>
            <button type="button"
                    class="ml-auto btn btn-ghost btn-xs"
                    data-action="click->checkout-phases#editShipping">
              Zmień
            </button>
          </div>
          <div class="p-6">
            <div class="bg-base-200/40 rounded-xl p-4 space-y-0.5">
              <p class="body-text font-semibold" data-checkout-phases-target="summaryShippingName">
                <%= order.shipping_address.first_name %> <%= order.shipping_address.last_name %>
              </p>
              <p class="body-secondary" data-checkout-phases-target="summaryShippingAddress1">
                <%= order.shipping_address.address_line1 %>
              </p>
              <p class="body-secondary <%= 'hidden' unless order.shipping_address.address_line2.present? %>"
                 data-checkout-phases-target="summaryShippingAddress2">
                <%= order.shipping_address.address_line2 %>
              </p>
              <p class="body-secondary" data-checkout-phases-target="summaryShippingPostalCity">
                <%= order.shipping_address.postal_code %> <%= order.shipping_address.city %>
              </p>
            </div>
          </div>
        </div>

        <!-- Box: Dane do faktury (hidden jeśli brak) -->
        <% billing_summary_visible = order.billing_address.needs_invoice? && order.billing_address.address_line1.present? %>
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden
                    <%= 'hidden' unless billing_summary_visible %>"
             data-checkout-phases-target="phase2BillingBox">
          <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
            <h2 class="subsection-title tracking-tight">Dane do faktury</h2>
            <button type="button"
                    class="ml-auto btn btn-ghost btn-xs"
                    data-action="click->checkout-phases#editBilling">
              Zmień
            </button>
          </div>
          <div class="p-6">
            <div class="bg-base-200/40 rounded-xl p-4 space-y-0.5">
              <p class="body-text font-semibold <%= 'hidden' unless order.billing_address.company_name.present? %>"
                 data-checkout-phases-target="summaryBillingCompany">
                <%= order.billing_address.company_name %>
              </p>
              <p class="body-secondary <%= 'hidden' unless order.billing_address.nip.present? %>"
                 data-checkout-phases-target="summaryBillingNip">
                NIP: <%= order.billing_address.nip %>
              </p>
              <p class="body-secondary" data-checkout-phases-target="summaryBillingName">
                <%= order.billing_address.first_name %> <%= order.billing_address.last_name %>
              </p>
              <p class="body-secondary" data-checkout-phases-target="summaryBillingAddress1">
                <%= order.billing_address.address_line1 %>
              </p>
              <p class="body-secondary" data-checkout-phases-target="summaryBillingPostalCity">
                <%= order.billing_address.postal_code %> <%= order.billing_address.city %>
              </p>
            </div>
          </div>
        </div>

        <!-- Sposób realizacji (open_package vs ship_now) -->
        <% if open_package_enabled %>
          <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
              <h2 class="subsection-title tracking-tight">Sposób realizacji</h2>
            </div>
            <div class="p-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <label class="relative flex flex-col p-5 border-2 border-base-300 rounded-xl cursor-pointer hover:border-warning/50 transition-all has-checked:border-warning has-checked:bg-warning/5"
                       data-action="change->checkout-form#toggleMode">
                  <input type="radio" name="commit_type" value="open_package"
                         class="radio radio-warning absolute top-4 right-4"
                         data-checkout-form-target="modeRadio" />
                  <div class="flex items-center gap-3 mb-2 pr-8">
                    <%= lucide_icon "package-open", class: "w-5 h-5 text-warning shrink-0" %>
                    <span class="subsection-title">Otwarta paczka</span>
                  </div>
                  <p class="body-secondary">Zapisz dane i wróć później, aby zamknąć paczkę i zapłacić.</p>
                </label>
                <label class="relative flex flex-col p-5 border-2 border-base-300 rounded-xl cursor-pointer hover:border-primary/50 transition-all has-checked:border-primary has-checked:bg-primary/5"
                       data-action="change->checkout-form#toggleMode">
                  <input type="radio" name="commit_type" value="ship_now"
                         class="radio radio-primary absolute top-4 right-4"
                         data-checkout-form-target="modeRadio" />
                  <div class="flex items-center gap-3 mb-2 pr-8">
                    <%= lucide_icon "send", class: "w-5 h-5 text-primary shrink-0" %>
                    <span class="subsection-title">Wyślij teraz</span>
                  </div>
                  <p class="body-secondary">Wybierz dostawę, płatność i złóż zamówienie od razu.</p>
                </label>
              </div>
            </div>
          </div>
        <% else %>
          <input type="hidden" name="commit_type" value="ship_now" />
        <% end %>

        <!-- Dostawa i płatność -->
        <div id="shipping-payment-section"
             class="<%= 'hidden' if open_package_enabled %> space-y-4"
             data-checkout-form-target="paymentSection">

          <!-- Metoda dostawy -->
          <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
              <%= lucide_icon "truck", class: "w-4 h-4 text-base-content/50" %>
              <h2 class="subsection-title tracking-tight">Metoda dostawy</h2>
            </div>
            <div class="px-6 py-4 space-y-2">
              <% shipping_methods.each do |method| %>
                <label class="flex items-center justify-between gap-4 p-4 border border-base-200 rounded-xl cursor-pointer hover:bg-base-200/30 hover:border-primary/30 transition-colors has-checked:border-primary has-checked:bg-primary/5">
                  <div class="flex items-center gap-3">
                    <%= f.radio_button :shipping_method_id, method.id,
                      class: "radio radio-primary shrink-0",
                      data: {
                        checkout_form_target: "shippingRadio",
                        action: "change->checkout-form#updateShipping",
                        price: method.price_for(items_subtotal).to_f,
                        is_pickup_point: method.is_pickup_point?,
                        pickup_point_provider: method.pickup_point_provider
                      } %>
                    <span class="body-text font-medium"><%= method.name %></span>
                  </div>
                  <span class="body-secondary shrink-0">
                    <%= method.free_above.present? ? "Darmowa od #{number_to_currency(method.free_above)}" : number_to_currency(method.price) %>
                  </span>
                </label>
              <% end %>
            </div>
            <%= render "checkouts/pickup_point_selector" %>
          </div>

          <!-- Metoda płatności -->
          <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm overflow-hidden">
            <div class="flex items-center gap-3 px-6 py-4 bg-base-200/40 border-b border-base-300/40">
              <%= lucide_icon "credit-card", class: "w-4 h-4 text-base-content/50" %>
              <h2 class="subsection-title tracking-tight">Metoda płatności</h2>
            </div>
            <div class="px-6 py-4 space-y-2">
              <% payment_methods.each do |method| %>
                <label class="flex items-center gap-3 p-4 border border-base-200 rounded-xl cursor-pointer hover:bg-base-200/30 hover:border-primary/30 transition-colors has-checked:border-primary has-checked:bg-primary/5">
                  <%= f.radio_button :payment_method, method.name,
                    class: "radio radio-primary shrink-0",
                    data: { checkout_form_target: "paymentRadio" } %>
                  <div>
                    <span class="body-text font-medium"><%= method.name %></span>
                    <% if method.description.present? %>
                      <p class="caption-text mt-0.5"><%= method.description %></p>
                    <% end %>
                  </div>
                </label>
              <% end %>
            </div>
          </div>
        </div>

        <!-- Regulamin + Submit -->
        <div class="bg-base-100 rounded-lg border border-base-300/60 shadow-sm p-6">
          <div class="form-control mb-5">
            <label class="label cursor-pointer justify-start gap-3 p-0">
              <input type="checkbox" class="checkbox checkbox-primary" required />
              <span class="label-text">Akceptuję regulamin i politykę prywatności *</span>
            </label>
          </div>
          <div data-checkout-form-target="submitArea">
            <button type="submit"
                    class="btn btn-primary btn-lg w-full rounded-xl font-semibold btn-disabled"
                    disabled
                    data-checkout-form-target="submitButton">
              Wybierz sposób realizacji
            </button>
          </div>
        </div>

      </div>
      <!-- ===================== END FAZA 2 ===================== -->

    <% end %>
  </div>

  <!-- Right column: Summary (sticky on desktop, top on mobile) -->
  <div class="w-full xl:w-105 shrink-0 order-first xl:order-last">
    <div class="xl:sticky xl:top-6">
      <%= render partial: "checkouts/order_summary", locals: { order: order } %>
    </div>
  </div>
</div>
