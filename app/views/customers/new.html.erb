<div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-4 mb-6">
  <%= render "shared/page_header",
        title: "Nowy klient",
        back_path: customers_path,
        back_label: "Klienci" %>
  <div class="flex gap-2 sm:pt-6">
    <%= link_to "Anuluj", customers_path, class: "btn btn-ghost" %>
    <button type="submit" form="customer_form" class="btn btn-primary">
      <%= lucide_icon("user-plus", class: "w-4 h-4") %>
      Dodaj klienta
    </button>
  </div>
</div>

<%= render "form" %>
