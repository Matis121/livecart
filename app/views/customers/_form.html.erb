<%= form_with model: @customer, id: "customer_form" do |f| %>
  <%
    phone_prefixes = [
      ["+48",  "PL +48"],  ["+49",  "DE +49"],  ["+43",  "AT +43"],
      ["+32",  "BE +32"],  ["+45",  "DK +45"],  ["+33",  "FR +33"],
      ["+30",  "GR +30"],  ["+31",  "NL +31"],  ["+353", "IE +353"],
      ["+39",  "IT +39"],  ["+1",   "CA/US +1"], ["+47",  "NO +47"],
      ["+351", "PT +351"], ["+40",  "RO +40"],  ["+421", "SK +421"],
      ["+386", "SI +386"], ["+34",  "ES +34"],  ["+46",  "SE +46"],
      ["+41",  "CH +41"],  ["+380", "UA +380"], ["+44",  "GB +44"],
      ["+420", "CZ +420"], ["+36",  "HU +36"],
    ]
    stored_phone = @customer.phone.to_s
    detected_prefix = phone_prefixes.map(&:first).sort_by { |p| -p.length }.find { |p| stored_phone.start_with?(p) } || "+48"
    detected_number = stored_phone.delete_prefix(detected_prefix)
  %>

  <%# Baner błędów %>
  <% if @customer.errors.any? %>
    <div class="flex items-start gap-3 px-4 py-3 mb-4 rounded-lg bg-error/10 border border-error/30 text-error">
      <%= lucide_icon("circle-alert", class: "w-4 h-4 mt-0.5 shrink-0") %>
      <div>
        <p class="font-medium text-sm">Popraw błędy przed zapisaniem:</p>
        <ul class="mt-1 space-y-0.5 text-sm list-disc list-inside">
          <% @customer.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# Górny rząd: Dane kontaktowe + Platformy %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">

    <!-- Dane kontaktowe -->
    <div class="bg-base-100 rounded-lg shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center gap-2">
        <%= lucide_icon("at-sign", class: "w-4 h-4 text-base-content/40") %>
        <h2 class="section-title">Dane kontaktowe</h2>
      </div>
      <div class="p-5 space-y-3">
        <div class="form-control">
          <%= f.label :email, "Email", class: "label label-text font-medium" %>
          <%= f.email_field :email,
                class: "input input-bordered w-full #{'input-error' if @customer.errors[:email].any?}",
                placeholder: "jan@example.pl" %>
          <% @customer.errors[:email].each do |msg| %>
            <p class="text-error text-xs mt-1"><%= msg %></p>
          <% end %>
        </div>
        <div class="form-control">
          <%= f.label :phone, "Telefon", class: "label label-text font-medium" %>
          <div class="flex gap-2">
            <select name="customer[phone_prefix]" class="select select-bordered w-28 shrink-0">
              <% phone_prefixes.each do |value, label| %>
                <option value="<%= value %>" <%= "selected" if detected_prefix == value %>><%= label %></option>
              <% end %>
            </select>
            <input type="tel"
                   name="customer[phone_number]"
                   class="input input-bordered flex-1 <%= 'input-error' if @customer.errors[:phone].any? %>"
                   placeholder="123456789"
                   value="<%= detected_number %>"
                   maxlength="9"
                   oninput="this.value = this.value.replace(/\D/g, '').slice(0, 9)">
          </div>
          <% @customer.errors[:phone].each do |msg| %>
            <p class="text-error text-xs mt-1"><%= msg %></p>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Platformy -->
    <div class="bg-base-100 rounded-lg shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center gap-2">
        <%= lucide_icon("tv-2", class: "w-4 h-4 text-base-content/40") %>
        <h2 class="section-title">Platformy</h2>
      </div>
      <div class="p-5 space-y-3">
        <div class="form-control">
          <label class="label label-text font-medium">Platforma</label>
          <select name="customer[platform]"
                  class="select select-bordered w-full"
                  onchange="document.getElementById('customer_nick_section').classList.toggle('hidden', this.value !== 'tiktok')">
            <option value="" <%= "selected" if @customer.platform.blank? %>>Brak</option>
            <option value="tiktok" <%= "selected" if @customer.platform == "tiktok" %>>TikTok</option>
          </select>
        </div>
        <div id="customer_nick_section" class="form-control <%= 'hidden' if @customer.platform != 'tiktok' %>">
          <%= f.label :platform_username, "Nick TikTok", class: "label label-text font-medium" %>
          <div class="input input-bordered flex items-center gap-2 w-full #{'input-error' if @customer.errors[:platform_username].any?}">
            <span class="text-base-content/40 select-none">@</span>
            <%= f.text_field :platform_username,
                  class: "grow bg-transparent outline-none",
                  placeholder: "twój_nick", maxlength: 24,
                  oninput: "this.value = this.value.replace(/[^a-zA-Z0-9._]/g, '').slice(0, 24)" %>
          </div>
          <% @customer.errors[:platform_username].each do |msg| %>
            <p class="text-error text-xs mt-1"><%= msg %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <%# Dolny rząd: Adres dostawy + Dane do faktury %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4">

    <!-- Adres dostawy -->
    <div class="bg-base-100 rounded-lg shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center gap-2">
        <%= lucide_icon("map-pin", class: "w-4 h-4 text-base-content/40") %>
        <h2 class="section-title">Adres dostawy</h2>
        <% if @customer.has_saved_shipping_address? %>
          <span class="ml-auto badge badge-sm badge-success">Zapisany</span>
        <% end %>
      </div>
      <div class="p-5 grid grid-cols-2 gap-3">
        <div class="form-control">
          <%= f.label :shipping_first_name, "Imię", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_first_name, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control">
          <%= f.label :shipping_last_name, "Nazwisko", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_last_name, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control col-span-2">
          <%= f.label :shipping_address_line1, "Ulica i numer", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_address_line1, class: "input input-bordered w-full", placeholder: "np. ul. Główna 123" %>
        </div>
        <div class="form-control col-span-2">
          <%= f.label :shipping_address_line2, "Dodatkowe informacje", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_address_line2, class: "input input-bordered w-full", placeholder: "np. mieszkanie 4" %>
        </div>
        <div class="form-control">
          <%= f.label :shipping_postal_code, "Kod pocztowy", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_postal_code, class: "input input-bordered w-full", placeholder: "00-000" %>
        </div>
        <div class="form-control">
          <%= f.label :shipping_city, "Miasto", class: "label label-text font-medium" %>
          <%= f.text_field :shipping_city, class: "input input-bordered w-full" %>
        </div>
        <div class="form-control col-span-2">
          <%= f.label :shipping_country, "Kraj", class: "label label-text font-medium" %>
          <%= f.select :shipping_country,
                options_for_select(ShippingAddress::COUNTRIES, @customer.shipping_country.presence || "PL"),
                {}, class: "select select-bordered w-full" %>
        </div>
      </div>
    </div>

    <!-- Dane do faktury -->
    <div class="bg-base-100 rounded-lg shadow-sm overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center gap-2">
        <%= lucide_icon("receipt", class: "w-4 h-4 text-base-content/40") %>
        <h2 class="section-title">Dane do faktury</h2>
        <% if @customer.has_saved_billing_data? %>
          <span class="ml-auto badge badge-sm badge-info">Zapisane</span>
        <% end %>
      </div>
      <div class="p-5">
        <div class="form-control mb-4">
          <label class="label cursor-pointer justify-start gap-3 p-0">
            <%= f.check_box :billing_needs_invoice,
                  class: "checkbox checkbox-primary",
                  onchange: "document.getElementById('customer_billing_fields').classList.toggle('hidden')" %>
            <span class="label-text font-medium">Faktura VAT</span>
          </label>
        </div>
        <div id="customer_billing_fields" class="<%= 'hidden' unless @customer.billing_needs_invoice == '1' %> grid grid-cols-2 gap-3">
          <div class="form-control col-span-2">
            <%= f.label :billing_company_name, "Nazwa firmy", class: "label label-text font-medium" %>
            <%= f.text_field :billing_company_name, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control">
            <%= f.label :billing_nip, "NIP", class: "label label-text font-medium" %>
            <%= f.text_field :billing_nip, class: "input input-bordered w-full", placeholder: "0000000000" %>
          </div>
          <div class="form-control">
            <%= f.label :billing_first_name, "Imię", class: "label label-text font-medium" %>
            <%= f.text_field :billing_first_name, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control">
            <%= f.label :billing_last_name, "Nazwisko", class: "label label-text font-medium" %>
            <%= f.text_field :billing_last_name, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control col-span-2">
            <%= f.label :billing_address_line1, "Ulica i numer", class: "label label-text font-medium" %>
            <%= f.text_field :billing_address_line1, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control">
            <%= f.label :billing_postal_code, "Kod pocztowy", class: "label label-text font-medium" %>
            <%= f.text_field :billing_postal_code, class: "input input-bordered w-full", placeholder: "00-000" %>
          </div>
          <div class="form-control">
            <%= f.label :billing_city, "Miasto", class: "label label-text font-medium" %>
            <%= f.text_field :billing_city, class: "input input-bordered w-full" %>
          </div>
          <div class="form-control col-span-2">
            <%= f.label :billing_country, "Kraj", class: "label label-text font-medium" %>
            <%= f.select :billing_country,
                  options_for_select(ShippingAddress::COUNTRIES, @customer.billing_country.presence || "PL"),
                  {}, class: "select select-bordered w-full" %>
          </div>
        </div>
      </div>
    </div>
  </div>

<% end %>
