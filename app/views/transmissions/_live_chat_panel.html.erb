<div class="card bg-base-100 shadow-md border border-base-200/60 h-full flex flex-col"
     data-controller="live-chat"
     data-live-chat-transmission-id-value="<%= transmission.id %>">
  <div class="card-body p-4 flex flex-col min-h-0 h-full">
    <!-- Header -->
    <div class="flex items-center justify-between mb-3 shrink-0">
      <h2 class="section-title">Wiadomość</h2>
      <div data-live-chat-target="statusBadge" class="badge badge-ghost badge-sm gap-1">
        <span class="w-1.5 h-1.5 rounded-full bg-base-content/30 inline-block"></span>
        <span data-live-chat-target="statusText">Łączenie...</span>
      </div>
    </div>
    <!-- Messages list -->
    <div class="flex-1 overflow-y-auto space-y-0.5 min-h-0"
         data-live-chat-target="messagesList">
      <% if chat_messages.blank? %>
        <div class="flex flex-col items-center justify-center h-full text-base-content/30"
             data-live-chat-target="emptyState">
          <%= lucide_icon("message-circle", class: "w-6 h-6 mb-1 opacity-30") %>
          <p class="text-center text-sm mt-1">Wiadomości pojawią się tutaj<br>gdy transmisja jest aktywna</p>
        </div>
      <% else %>
        <% chat_messages.each do |msg| %>
          <% customer_id = registered_sender_map[msg.sender_id] %>
          <% is_registered = customer_id.present? %>
          <div class="flex items-start gap-2 px-2 py-2 rounded-lg hover:bg-base-200/60 transition-colors group"
               data-live-chat-prerendered>
            <div class="mt-0.5 opacity-70"><%= platform_icons[msg.platform].html_safe %></div>
            <div class="min-w-0 flex-1">
              <% if msg.platform == "tiktok" %>
                <% if is_registered %>
                  <%= lucide_icon("circle-check", class: "w-3.5 h-3.5 text-success inline-block align-middle mr-0.5 mb-0.5", title: "Klient w bazie") %>
                <% else %>
                  <%= lucide_icon("circle-x", class: "w-3.5 h-3.5 text-base-content/30 inline-block align-middle mr-0.5 mb-0.5", title: "Niezarejestrowany") %>
                <% end %>
              <% end %><button type="button"
                      class="font-semibold text-sm mr-1 <%= is_registered || msg.platform != 'tiktok' ? 'text-primary hover:underline cursor-pointer' : 'text-base-content/40 cursor-default' %>"
                      <% if is_registered || msg.platform != "tiktok" %>
                      data-action="click->live-chat#selectUser"
                      <% end %>
                      data-username="<%= html_escape(msg.sender_id) %>"
                      data-platform="<%= msg.platform %>"
                      data-customer-id="<%= customer_id %>"
                      data-registered="<%= is_registered %>">
                @<%= html_escape(msg.sender_name) %>
              </button><span class="text-sm text-base-content/80 wrap-break-word"><%= html_escape(msg.body) %></span>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
